# app database
POSTGRES_DB=f1_prediction
POSTGRES_USER=f1_admin
POSTGRES_PASSWORD=change-me

# webapp -> api address when running OUTSIDE docker (compose overrides it)
API_URL=http://localhost:8000

# airflow metadata database
AIRFLOW_DB_PASSWORD=change-me-too

# generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_JWT_SECRET=
# generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(64)).decode())"
AIRFLOW_SECRET_KEY=

# Teams Workflows webhooks (empty = alerts are only logged)
# Data Quality Alerts channel: ingestion DAG
TEAMS_WEBHOOK_URL=
# ML Alerts channel: training DAG (failed promotion), Grafana drift alerts
ML_ALERTS_WEBHOOK_URL=

# Grafana and nginx (one entry point at http://localhost:8080)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
NGINX_PORT=8080
# For remote demo access, replace localhost with the demo machine's reachable host/IP.
PUBLIC_BASE_URL=http://localhost:8080

# Linux hosts: set to your user id (`id -u`) so Airflow can write the mounted
# data/ folder; macOS/Windows can leave it unset
AIRFLOW_UID=1000

# MLflow UI on the host (http://localhost:5000). macOS: port 5000 is taken
# by AirPlay Receiver - use e.g. 5001
MLFLOW_PORT=5000
# registered model name in the MLflow model registry
MLFLOW_MODEL_NAME=f1-top10

# Data feeder: a batch of FEEDER_BATCH_SIZE rows every FEEDER_INTERVAL_SECONDS,
# with random data-quality errors. DRIFT_MODE=true shifts Grid and
# ConstructorName to trigger the drift alerts.
FEEDER_BATCH_SIZE=20
FEEDER_INTERVAL_SECONDS=60
FEEDER_ERROR_PROB=0.015
FEEDER_MISSING_COLUMN_PROB=0.005
DRIFT_MODE=false
